    "@types/ws": "^7.2.6",
    "accesscontrol": "^2.2.1",
    "body-parser": "^1.19.0",
    "bunyan": "^1.8.15",
    "cors": "^2.8.5",
    "crypto-js": "^4.0.0",
    "dotenv": "^8.2.0",
    "email-validator": "^2.0.4",
    "eosjs": "^21.0.3",
    "eosjs-ecc": "^4.0.7",
    "errorhandler": "^1.5.1",
    "express": "^4.17.1",
    "faker": "^4.1.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.2.9",
    "morgan": "^1.10.0",
    "node-fetch": "^2.6.0",
    "on-finished": "^2.3.0",
    "prom-client": "^13.1.0",
    "socket.io-client": "^2.3.0",
    "superagent": "^6.1.0",
    "swagger-ui-express": "^4.1.4",
    "tsoa": "^3.14.1",
    "underscore": "^1.13.3",
